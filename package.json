{
  "name": "abdiel-digital-observatory",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "npm run check && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "prototype": "node server.mjs",
    "check": "tsc --noEmit && tsx --test tests/content.test.ts && npm run check:prototype",
    "check:prototype": "node --check prototype/main.js && node --check prototype/lensing.js"
  },
  "dependencies": {
    "next": "^16.4.2",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "0.180.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
